# Copy this file to .env locally and fill in real values.
# NEVER commit the real .env file — it's already in .gitignore.
# On Render, set these under your service's "Environment" tab instead of
# uploading a .env file.

# Postgres connection string (e.g. from Supabase, Render Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database

# Cloudinary credentials (Dashboard -> your account -> API Keys)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Maps location picker for Campus Market listings.
# Enable the Maps JavaScript API and restrict this browser key to your app's domain.
GOOGLE_MAPS_API_KEY=your-google-maps-browser-api-key

# AI quiz generation: Gemini is preferred when configured. Keep keys server-side.
GEMINI_API_KEY=
GEMINI_QUIZ_MODEL=gemini-3.1-flash-lite
# Optional fallback, used only when Gemini is not configured.
OPENAI_API_KEY=
# Optional model override for OpenAI quiz generation.
OPENAI_QUIZ_MODEL=gpt-5.4-mini

# Premium HD PayU South Africa hosted checkout. Obtain these from your PayU
# merchant account and set them in Render's Environment tab for live payments.
PUBLIC_BASE_URL=https://arounus.com
PAYU_SA_ENVIRONMENT=production
PAYU_SA_SAFEKEY=your-payu-sa-safekey
PAYU_SA_SOAP_USERNAME=your-payu-sa-soap-username
PAYU_SA_SOAP_PASSWORD=your-payu-sa-soap-password
# Optional: comma separated methods enabled on your PayU merchant account.
PAYU_SA_PAYMENT_METHODS=CREDITCARD

# Paystack hosted checkout serves Premium HD and voluntary support payments.
# Keep disabled until the registered company is approved and the live key is set.
PAYSTACK_SECRET_KEY=
PAYSTACK_ENABLED=false
# New timestamped webhook signing secret (whsec_) from Paystack Developers.
# Leave blank only while the integration uses legacy x-paystack-signature events.
PAYSTACK_WEBHOOK_SECRET=

# Required in production: a private administrator value of at least 8 characters.
LECTURER_PIN=

# Required in production: generate each secret separately with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never use the administrator PIN or copy a published example.
AROUNUS_ENV=production
# Lecturer session signing key:
LECTURER_SESSION_SECRET=

# Required in production: a separate long, random value used to sign student sessions.
STUDENT_SESSION_SECRET=

# Optional role-specific keys; default to the student key with role-bound tokens.
SRC_SESSION_SECRET=
LANDLORD_SESSION_SECRET=

# Web Push notifications for installed learner and advertiser apps.
# Generate VAPID keys once, then add the same values in Render's Environment tab.
# The public key is sent to browsers; the private key must stay secret.
VAPID_PUBLIC_KEY=your-base64url-vapid-public-key
VAPID_PRIVATE_KEY=your-base64url-vapid-private-key
VAPID_SUBJECT=mailto:admin@your-institution.example

# Password recovery and automatic room submission/approval emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@arounus.com
# SMTP_SSL is optional; port 465 uses SSL automatically.
SMTP_SSL=0
# Optional separate random secret; defaults to STUDENT_SESSION_SECRET.
PASSWORD_RESET_SECRET=
# LOCAL TESTING ONLY: exposes reset codes in API responses. Keep disabled live.
AROUNUS_DEV_RESET_CODES=0

# Keep interactive API documentation private unless explicitly needed.
ENABLE_API_DOCS=0
# Optional public security-reporting contact (URL or mailto: address).
SECURITY_CONTACT=https://arounus.com/trust#support

# Legacy Ozow configuration is retained only to verify payments already started.
# New Arounus checkouts use Paystack.
OZOW_ENABLED=false
OZOW_ENV=production
OZOW_CLIENT_ID=
OZOW_CLIENT_SECRET=
OZOW_SITE_CODE=
